# Copy to .env and adjust. Hostnames below target services running on the host;
# docker-compose overrides POSTGRES_HOST and REDIS_URL with container hostnames.

# PostgreSQL
POSTGRES_DB=hangar
POSTGRES_USER=hangar
POSTGRES_PASSWORD=hangar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# Frontend (inlined into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
